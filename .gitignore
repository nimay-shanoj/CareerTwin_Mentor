# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Environment & secrets
.env
.env.*
!.env.example

# Local database files
*.db
*.sqlite
*.sqlite3

# User uploads (never commit real resumes)
uploads/*
!uploads/.gitkeep

# TLS material (stretch goal) – never commit private keys
certs/
*.key
*.pem

# Archives / IDE cruft
*.zip
.idea/
.vscode/
*.swp

# OS noise
.DS_Store
Thumbs.db

# Flask
instance/
