# ---------------------------------------------------------------------------
# CareerTwin – environment configuration
#
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" for local development (disables Secure cookies + shows tracebacks)
FLASK_DEBUG=false

# --- Database ----------------------------------------------------------------
# Highest priority. A full SQLAlchemy URL. When set it wins over everything else.
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/careertwin
# DATABASE_URL=sqlite:///careertwin.db

# Alternatively configure MySQL piecewise (MySQL stays the default local engine).
# When these are absent and DATABASE_URL is unset, the app falls back to a local
# SQLite file (careertwin.db) so a fresh clone still starts.
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=careertwin

# --- Uploads -----------------------------------------------------------------
# Where uploaded resumes are stored. Defaults to ./uploads locally and
# /tmp/uploads on Vercel.
# UPLOAD_FOLDER=

# --- Chat: WebSocket ---------------------------------------------------------
# "threading" (default, good for dev) | "eventlet" | "gevent"
SOCKETIO_ASYNC_MODE=threading

# Comma-separated allowed origins for the Socket.IO handshake.
# Never use "*" in production. Leave empty to allow same-origin only.
SOCKETIO_CORS_ALLOWED_ORIGINS=

# --- Chat: shared behaviour --------------------------------------------------
# Lifetime of a single-use TCP handshake token, in seconds.
CHAT_TOKEN_TTL=60
# Rate limit: max messages per window, per user.
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW=10
# Hard cap on a single message body.
CHAT_MAX_MESSAGE_CHARS=2000

# --- Chat: raw TCP server ----------------------------------------------------
# Enable/disable the hand-written TCP chat server.
TCP_CHAT_ENABLED=true
TCP_CHAT_HOST=127.0.0.1
TCP_CHAT_PORT=9000
TCP_CHAT_MAX_CONNECTIONS=100
# Maximum frame payload in bytes (16 KiB).
TCP_CHAT_MAX_PAYLOAD=16384
# Server heartbeat interval advertised to clients, in seconds.
TCP_CHAT_HEARTBEAT=5
# Drop a connection that sent no frame for this many seconds.
TCP_CHAT_IDLE_TIMEOUT=30
# A client must send HELLO within this many seconds or it is dropped.
TCP_CHAT_HELLO_TIMEOUT=5
# Per-connection bounded write queue (backpressure).
TCP_CHAT_WRITE_QUEUE_LIMIT=64

# --- Seed script --------------------------------------------------------------
# Password given to the fake demo mentors created by scripts/seed_mentors.py.
# Never printed by the script.
SEED_MENTOR_PASSWORD=
